# ----------------------------------------------------------
# Shared environment template. Copy to .env at the repo root
# for local development; each app may also have its own
# .env file scoped to that app.
# ----------------------------------------------------------

NODE_ENV=development

# Database
DATABASE_URL=postgresql://drivethru:drivethru@localhost:5432/drivethru?schema=public

# Cache & queue
REDIS_URL=redis://localhost:6379

# Object storage (S3 compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=drivethru-assets
STORAGE_ACCESS_KEY=drivethru
STORAGE_SECRET_KEY=drivethru-secret

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# SMS provider (Unifonic / Twilio etc.)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=DRIVETHRU

# Push notifications
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Payment providers
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MADA_MERCHANT_ID=
STC_PAY_MERCHANT_ID=

# Maps
GOOGLE_MAPS_API_KEY=

# ZATCA E-Invoicing
ZATCA_ENVIRONMENT=sandbox
ZATCA_CERT_PATH=
ZATCA_PRIVATE_KEY_PATH=
